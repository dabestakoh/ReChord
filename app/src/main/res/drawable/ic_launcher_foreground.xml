                    android:startX="128"
                    android:startY="89"
                    android:endX="128"
                    android:endY="139">
                    <item android:offset="0.0" android:color="#FF8B5CF6" />
                    <item android:offset="0.5" android:color="#FFD946EF" />
                    <item android:offset="1.0" android:color="#FFF43F5E" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Right equalizer bar -->
        <path android:pathData="M143.25,100 A4.25,4.25 0 0,1 147.5,104.25 L147.5,123.75 A4.25,4.25 0 0,1 139,123.75 L139,104.25 A4.25,4.25 0 0,1 143.25,100 Z">
