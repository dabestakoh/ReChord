        <path android:pathData="M112.75,100 A4.25,4.25 0 0,1 117,104.25 L117,123.75 A4.25,4.25 0 0,1 108.5,123.75 L108.5,104.25 A4.25,4.25 0 0,1 112.75,100 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="112.75"
                    android:startY="90"
                    android:endX="112.75"
                    android:endY="140">
                    <item android:offset="0.0" android:color="#FF8B5CF6" />
                    <item android:offset="0.5" android:color="#FFD946EF" />
                    <item android:offset="1.0" android:color="#FFF43F5E" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Center tallest equalizer bar -->
        <path android:pathData="M128,89 A4.25,4.25 0 0,1 132.25,93.25 L132.25,134.75 A4.25,4.25 0 0,1 123.75,134.75 L123.75,93.25 A4.25,4.25 0 0,1 128,89 Z">
