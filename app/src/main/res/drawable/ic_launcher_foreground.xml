    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="256"
    android:viewportHeight="256">
    <group
        android:scaleX="0.68"
        android:scaleY="0.68"
        android:pivotX="128"
        android:pivotY="128">
        <!-- Precision concentric vinyl grooves -->
        <path
            android:pathData="M128,54 A60,60 0 1,1 127.99,54 Z"
            android:strokeColor="#2EFFFFFF"
            android:strokeWidth="1.6" />
        <path
            android:pathData="M128,60 A54,54 0 1,1 127.99,60 Z"
            android:strokeColor="#3DFFFFFF"
            android:strokeWidth="1.6" />
        <path
            android:pathData="M128,66 A48,48 0 1,1 127.99,66 Z"
            android:strokeColor="#2BFFFFFF"
            android:strokeWidth="1.6" />
        <!-- Bottom vinyl rim arc between left stem and right leg -->
        <path
            android:pathData="M98,176 A69,69 0 0,0 144,180"
            android:strokeColor="#FFEAF0FA"
            android:strokeWidth="10" />
        <!-- Outer Vinyl R arc + diagonal right leg -->
        <path
            android:pathData="M60,114 A68,68 0 1,1 164,171 L192,199 L167,199 L127,151"
            android:strokeColor="#FFF4F6FA"
            android:strokeWidth="11"
            android:strokeLineCap="square"
            android:strokeLineJoin="miter" />
        <!-- Left vertical stem -->
        <path
            android:pathData="M60,114 L60,199 L88,199 L88,114"
            android:strokeColor="#FFF4F6FA"
            android:strokeWidth="11"
            android:strokeLineCap="square"
            android:strokeLineJoin="miter" />
        <!-- Inner vinyl label ring -->
        <path
            android:pathData="M128,77 A37,37 0 1,1 127.99,77 Z"
            android:fillColor="#FF0B0D14"
            android:strokeColor="#FFF4F6FA"
            android:strokeWidth="10" />
